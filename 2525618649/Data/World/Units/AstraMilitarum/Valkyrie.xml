<?xml version="1.0" encoding="utf-8"?>
<unit>
	<model>
		<unit mesh="Units/AstraMilitarum/Valkyrie"
				material="Units/AstraMilitarum/Valkyrie"
				position="0 0 64"
				idleAnimation="Units/AstraMilitarum/ValkyrieIdle"
				idleAnimationCount="2"
				idleContinuously="1"
				explosionsBone="Hull"
				normalWeight="1.0"
				scale="0.8 0.8 0.8"/>
	</model>
	<group size="2" rowSize="2" memberDeltaX="83" memberDeltaY="63"/>	
	<weapons>
		<weapon name="MultiLaser">
			<model>
				<beamWeapon mesh="Weapons/AstraMilitarum/ValkyrieMultiLaser"
						material="Units/AstraMilitarum/Valkyrie"
						bone=".MultiLaserMuzzle0"
						muzzleBone=".MultiLaserMuzzle0"/>
			</model>
		</weapon>
		<weapon name="None" enabled="0">
			<model>
				<weapon mesh="Weapons/AstraMilitarum/ValkyrieHellstrikeMissile"
						material="Units/AstraMilitarum/Valkyrie"
						bone=".HellstrikeMissile0"/>
			</model>
		</weapon>
		<weapon name="None" enabled="0">
			<model>
				<weapon mesh="Weapons/AstraMilitarum/ValkyrieHellstrikeMissile"
						material="Units/AstraMilitarum/Valkyrie"
						bone=".HellstrikeMissile1"/>
			</model>
		</weapon>
		<weapon name="HellstrikeMissile">
			<model>
				<missileWeapon muzzleBone=".HellstrikeMissile"
						muzzleCount="2"
						fireInterval="1.2"
						missileScale="0.8"/>
			</model>
		</weapon>
		<weapon name="HeavyBolter" count="4"
				requiredUpgrade="AstraMilitarum/AdditionalHeavyBolters">
			<model>
				<projectileWeapon mesh="Weapons/AstraMilitarum/ValkyrieHeavyBolters"
						material="Weapons/AstraMilitarum/HydraHeavyBolter"
						bone="Hull"
						muzzleBone=".Muzzle"
						muzzleCount="2"/>
			</model>	
		</weapon>
	</weapons>
	<modifiers>
		<modifier visible="0">
			<effects>
				<armor base="5"/> <!-- %armor base armor=12/12/10 -->
				<cargoSlots base="4"/> <!-- %cargoSlots base capacity=12 -->
				<energyUpkeep base="5.0"/> <!-- %energyUpkeep base tier=7 factor=1 -->
				<energyCost base="45.0"/> <!-- %energyCost base tier=7 factor=0.5 -->
				<hitpointsMax base="12.0"/> <!-- %hitpointsMax base armor=12/12/10 wounds=3 -->
				<oreCost base="45.0"/> <!-- %oreCost base tier=7 factor=0.5 -->
				<moraleMax base="14"/> <!-- %moraleMax base leadership=7 -->
				<movementMax base="8"/>
				<productionCost base="49.0"/> <!-- %productionCost base tier=7 factor=1 -->
				<rangedAccuracy base="7"/> <!-- %rangedAccuracy base ballisticSkill=3 -->
			</effects>
		</modifier>
	</modifiers>
	<strategyModifiers>
		<modifier>
			<effects>
				<increaseAircraftScore base="1.0"/>
			</effects>
		</modifier>
	</strategyModifiers>
	<actions>
		<attack>
			<model>
				<action animation="Units/AstraMilitarum/ValkyrieAttack"
						beginFire="0.1" endFire="2.5"/>
			</model>				
		</attack>
		<die>
			<model>
				<action animation="Units/AstraMilitarum/ValkyrieDie"
						sound="Units/MediumVehicleDie"
						soundCount="3"
						soundDelay="0.2"/>
			</model>		
		</die>
		<move>
			<model>
				<action sound="Units/AstraMilitarum/ValkyrieMove"
						soundCount="3"/>
			</model>				
		</move>
		<jink consumedActionPoints="0" consumedMovement="0" requiredActionPoints="0" cooldown="3">
			<model>
				<action sound="Actions/ChargeUp"/>
			</model>
			<beginTargets>
				<selfTarget>
					<conditions>
						<unit>
							<notAttackedThisTurn/>
						</unit>
					</conditions>
					<areas>
						<area affects="Unit">
							<modifiers>
								<modifier>
									<effects>
										<addTrait duration="1" name="Jink"/>
									</effects>
								</modifier>
							</modifiers>
						</area>
					</areas>
				</selfTarget>
			</beginTargets>
		</jink>
	</actions>
	<traits>
		<trait name="Imperial"/>
		<trait name="ExtraVehicleArmour" requiredUpgrade="AstraMilitarum/ExtraVehicleArmour"/>
		<trait name="Flyer"/>
		<!-- <trait name="Hover"/> -->
		<trait name="Transport"/>
		<trait name="Vehicle"/>
	</traits>
</unit>
